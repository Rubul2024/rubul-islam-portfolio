# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development, and add the
# same variables in your hosting provider (e.g. Vercel → Settings →
# Environment Variables). Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public production URL, without a trailing slash.
# Used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# Example: https://rubulislam.dev
NEXT_PUBLIC_SITE_URL=

# ── Contact form delivery (server-side only, via Resend) ─────
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that receives contact-form messages.
CONTACT_TO_EMAIL=mcarubul2021@gmail.com

# Sender address. "onboarding@resend.dev" works for testing and can only
# deliver to the email address that owns your Resend account. After you
# verify your own domain in Resend, change it to e.g.
# "Rubul Islam Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ── Blog database (MongoDB) ──────────────────────────────────
# Free cluster: https://www.mongodb.com/cloud/atlas → Connect → Drivers.
# In Atlas → Network Access, allow 0.0.0.0/0 when deploying to Vercel.
MONGODB_URI=
MONGODB_DB=portfolio

# ── Blog admin panel (/admin) ────────────────────────────────
# Generate the hash and secret with:  npm run admin:setup
ADMIN_EMAIL=mcarubul2021@gmail.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
